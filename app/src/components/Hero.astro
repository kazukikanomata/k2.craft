---
// src/components/Hero.astro
interface Props {
  title: string;
}

const { title }: Props = Astro.props;
---

<section class="hero">
  <canvas id="hero-cube" class="hero-cube" aria-hidden="true"></canvas>
  <h1 class="hero-title">{title}</h1>
</section>

<script>
  const canvas = document.getElementById("hero-cube") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d");

  if (canvas && ctx) {
    const ACCENT = "37, 99, 235"; // #2563EB as r,g,b
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const size = Math.round(canvas.getBoundingClientRect().width) || 300;

    canvas.width = size * dpr;
    canvas.height = size * dpr;
    ctx.scale(dpr, dpr);

    type Vec3 = [number, number, number];

    type Point = {
      x: number;
      y: number;
      z: number;
      nx: number;
      ny: number;
      nz: number;
      density: number;
      lit: number;
      sq: number;
    };

    // 光源方向（左上手前）。面の法線との内積で陰影（=面ごとの明るさ）をつくる。
    const light = { x: -0.5, y: -0.6, z: 0.62 };
    const lightLen = Math.hypot(light.x, light.y, light.z);
    light.x /= lightLen;
    light.y /= lightLen;
    light.z /= lightLen;

    // 3x3の溝（グルーブ）幅。境界(±1/3)付近の点を間引いてキューブの区切り線を表現する。
    const GROOVE = 0.045;
    const isGroove = (t: number) => Math.abs(t + 1 / 3) < GROOVE || Math.abs(t - 1 / 3) < GROOVE;

    const buildCubeFace = (
      normal: Vec3,
      uAxis: Vec3,
      vAxis: Vec3,
      half: number,
      resolution: number,
      faceSeed: number
    ): Point[] => {
      const points: Point[] = [];
      const lit = Math.max(0.12, normal[0] * light.x + normal[1] * light.y + normal[2] * light.z);

      for (let i = 0; i < resolution; i++) {
        const u = (i / (resolution - 1)) * 2 - 1;
        if (isGroove(u)) continue;
        for (let j = 0; j < resolution; j++) {
          const v = (j / (resolution - 1)) * 2 - 1;
          if (isGroove(v)) continue;

          // ステッカーごとに明度を微妙にずらし、面の中に9マスあることを感じさせる
          const cellU = u < -1 / 3 ? 0 : u < 1 / 3 ? 1 : 2;
          const cellV = v < -1 / 3 ? 0 : v < 1 / 3 ? 1 : 2;
          const cellShade = 0.82 + (((cellU * 3 + cellV) * 37 + faceSeed * 13) % 7) * 0.03;

          points.push({
            x: normal[0] * half + u * half * uAxis[0] + v * half * vAxis[0],
            y: normal[1] * half + u * half * uAxis[1] + v * half * vAxis[1],
            z: normal[2] * half + u * half * uAxis[2] + v * half * vAxis[2],
            nx: normal[0],
            ny: normal[1],
            nz: normal[2],
            density: Math.min(1, Math.max(0.06, lit * cellShade)),
            lit,
            sq: Math.random(),
          });
        }
      }
      return points;
    };

    const half = size * 0.26;
    const resolution = 15;
    const faces: { normal: Vec3; uAxis: Vec3; vAxis: Vec3 }[] = [
      { normal: [1, 0, 0], uAxis: [0, 1, 0], vAxis: [0, 0, 1] },
      { normal: [-1, 0, 0], uAxis: [0, 1, 0], vAxis: [0, 0, 1] },
      { normal: [0, 1, 0], uAxis: [1, 0, 0], vAxis: [0, 0, 1] },
      { normal: [0, -1, 0], uAxis: [1, 0, 0], vAxis: [0, 0, 1] },
      { normal: [0, 0, 1], uAxis: [1, 0, 0], vAxis: [0, 1, 0] },
      { normal: [0, 0, -1], uAxis: [1, 0, 0], vAxis: [0, 1, 0] },
    ];
    const points: Point[] = faces.flatMap((f, idx) =>
      buildCubeFace(f.normal, f.uAxis, f.vAxis, half, resolution, idx)
    );

    let angle = 0;
    let tiltPhase = 0;
    const focal = size * 0.9;
    const cx = size / 2;
    const cy = size / 2;

    const render = () => {
      ctx.clearRect(0, 0, size, size);
      const cosA = Math.cos(angle);
      const sinA = Math.sin(angle);
      const tilt = -0.32 + Math.sin(tiltPhase) * 0.14;
      const cosT = Math.cos(tilt);
      const sinT = Math.sin(tilt);

      const projected = points
        .map((p) => {
          const x1 = p.x * cosA - p.z * sinA;
          const z1 = p.x * sinA + p.z * cosA;
          const y2 = p.y * cosT - z1 * sinT;
          const z2 = p.y * sinT + z1 * cosT;

          // 法線も同じ回転を適用し、カメラを向いていない面（裏面）は描画しない
          const nx1 = p.nx * cosA - p.nz * sinA;
          const nz1 = p.nx * sinA + p.nz * cosA;
          const nz2 = p.ny * sinT + nz1 * cosT;
          if (nz2 >= -0.02) return null;

          const scale = focal / (focal + z2 + size * 0.35);
          return {
            sx: cx + x1 * scale,
            sy: cy + y2 * scale,
            scale,
            density: p.density,
            lit: p.lit,
            sq: p.sq,
          };
        })
        .filter((p): p is NonNullable<typeof p> => p !== null)
        .sort((a, b) => a.scale - b.scale);

      for (const p of projected) {
        if (p.sq > p.density) continue;
        const s = Math.max(1.2, size * 0.024 * (0.55 + p.lit * 0.85) * p.scale);
        const alpha = Math.min(1, 0.18 + p.density * 0.82) * Math.min(1, p.scale);
        ctx.fillStyle = `rgba(${ACCENT}, ${alpha.toFixed(3)})`;
        ctx.fillRect(p.sx - s / 2, p.sy - s / 2, s, s);
      }
    };

    if (reduceMotion) {
      angle = 0.6;
      tiltPhase = 0;
      render();
    } else {
      let last = performance.now();
      const loop = (now: number) => {
        const dt = (now - last) / 1000;
        last = now;
        angle += dt * 0.32;
        tiltPhase += dt * 0.18;
        render();
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>
