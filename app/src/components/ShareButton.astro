---
// src/components/ShareButton.astro
// X(Twitter)への共有リンクは常に表示し、Web Share APIに対応する端末では
// ネイティブ共有ボタンも合わせて表示する(非対応環境ではhiddenのまま)。
interface Props {
  title: string;
}

const { title }: Props = Astro.props;
const url = Astro.url.href;
const xShareUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
---

<div class="flex flex-wrap items-center gap-3">
  <a
    href={xShareUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex h-11 items-center gap-2 border border-line px-4 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
      <path d="M18.9 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
    </svg>
    Xでシェア
  </a>
  <button
    type="button"
    data-native-share
    data-share-url={url}
    data-share-title={title}
    hidden
    class="flex h-11 items-center gap-2 border border-line px-4 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342a3 3 0 100-2.684m0 2.684a3 3 0 100 2.684m0-2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 10.632a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
    </svg>
    共有
  </button>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-native-share]");
  if (button && "share" in navigator) {
    button.hidden = false;
    button.addEventListener("click", () => {
      navigator
        .share({
          title: button.dataset.shareTitle,
          url: button.dataset.shareUrl,
        })
        .catch(() => {
          // ユーザーによるキャンセル等は無視する
        });
    });
  }
</script>
