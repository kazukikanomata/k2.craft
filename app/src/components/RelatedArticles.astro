---
// src/components/RelatedArticles.astro
import BlogList from "@components/BlogList.astro";
import type { Post } from "@libs/blog.ts";

interface Props {
  posts: Post[];
}

const { posts }: Props = Astro.props;
---

{
  posts.length > 0 && (
    <section>
      <h2 class="mb-4 text-xs font-mono uppercase tracking-wider text-muted">関連記事</h2>
      <BlogList posts={posts} />
    </section>
  )
}
