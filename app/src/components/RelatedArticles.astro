---
// src/components/RelatedArticles.astro
import BlogList from "@components/BlogList.astro";
import type { Blog } from "@libs/microcms.ts";

interface Props {
  blogs: Blog[];
}

const { blogs }: Props = Astro.props;
---

{
  blogs.length > 0 && (
    <section>
      <h2 class="mb-4 text-xs font-mono uppercase tracking-wider text-muted">関連記事</h2>
      <BlogList blogs={blogs} />
    </section>
  )
}
