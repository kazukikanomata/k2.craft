---
// src/components/Footer.astro
const { title } = Astro.props;
---

<footer class="border-t">
  <div
    class="max-w-[1600px] w-full mx-auto px-4 md:px-6 xl:px-10 py-6 flex items-center justify-between"
  >
    <p class="text-xs font-mono text-muted">
      &copy; {new Date().getFullYear()}
      {title}
    </p>
    <a
      href="/about"
      class="text-xs font-mono text-muted hover:text-accent transition no-underline"
    >
      About
    </a>
  </div>
</footer>
