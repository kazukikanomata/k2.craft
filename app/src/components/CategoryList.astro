---
// src/components/CategoryList.astro
import { categories } from "@libs/blog.ts";
---

<div class="border border-line">
  <div class="p-6 pb-0">
    <h3 class="text-xs font-mono uppercase tracking-wider text-muted">
      Categories
    </h3>
  </div>
  <ul class="space-y-2 p-6">
    {
      categories.map((category) => (
        <li>
          <a
            href={`/category/${category.slug}`}
            class="flex items-center gap-2 text-sm text-ink hover:text-accent no-underline transition"
          >
            <span class="w-2 h-2 bg-accent shrink-0" aria-hidden="true" />
            {category.name}
          </a>
        </li>
      ))
    }
  </ul>
</div>
