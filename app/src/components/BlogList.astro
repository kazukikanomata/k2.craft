---
// src/components/BlogList.astro
import Date from "@components/Date.astro";
import type { Post } from "@libs/blog.ts";

interface Props {
  posts: Post[];
}

const { posts }: Props = Astro.props;
---

{
  posts.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {posts.map(({ id, data }) => (
        <a
          href={`/blog/${id}`}
          class="block border border-line p-4 hover:border-accent transition no-underline"
        >
          <div
            class="mb-4 flex h-32 items-center justify-center bg-gray-50 text-5xl dark:bg-gray-900"
            aria-hidden="true"
          >
            {data.icon}
          </div>
          {!data.published && <span class="tag mb-2">Draft</span>}
          <h3 class="text-xl font-medium mb-1 text-ink">{data.title}</h3>
          <p class="mb-2">
            <Date date={data.publishedAt} />
          </p>
          <p class="text-sm text-muted">{data.description}</p>
        </a>
      ))}
    </div>
  ) : (
    <p class="text-center text-gray-500 dark:text-gray-400 text-lg">記事がありません</p>
  )
}
