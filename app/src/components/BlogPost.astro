---
// src/components/BlogPost.astro
import Date from "@components/Date.astro";
import ShareButton from "@components/ShareButton.astro";
import MarkdownCopyButton from "@components/MarkdownCopyButton.astro";
import TableOfContents, { type TocItem } from "@components/TableOfContents.astro";
import { CATEGORIES } from "@constants/index.ts";
import type { Post } from "@libs/blog.ts";

interface Props {
  post: Post;
  toc: TocItem[];
}

const { post, toc } = Astro.props;
const { title, description, icon, publishedAt, category } = post.data;

// 記事のMarkdownソースをそのままコピー用に渡す
const markdown = `# ${title}\n\n${post.body ?? ""}`;
---

<article>
  <div class="mx-auto max-w-6xl">
    <a
      href="/"
      class="inline-flex items-center gap-1 px-4 py-2 -ml-4 text-sm text-muted no-underline transition-colors hover:text-accent"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to blog
    </a>
  </div>

  <header class="mx-auto mt-6 max-w-3xl">
    <div class="mb-8 text-center text-8xl leading-none" aria-hidden="true">{icon}</div>

    <h1 class="text-3xl font-bold leading-tight text-ink md:text-4xl">{title}</h1>

    <p class="mt-6 flex items-center gap-1 font-mono text-xs text-muted">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
        ></path>
      </svg>
      <Date date={publishedAt} />
    </p>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        {!post.data.published && <span class="tag">Draft</span>}
        {
          category.length > 0 ? (
            category.map((name) => (
              <a href={`/category/${CATEGORIES[name]}`} class="tag">
                #{name}
              </a>
            ))
          ) : (
            <span class="text-muted text-xs">No Category</span>
          )
        }
      </div>
      <MarkdownCopyButton markdown={markdown} />
    </div>

    <p class="mt-6 text-lg leading-relaxed text-muted">{description}</p>

    {toc.length > 0 && <TableOfContents items={toc} variant="mobile" />}
  </header>

  <div class="mx-auto mt-12 max-w-[1100px] lg:grid lg:grid-cols-[minmax(0,756px)_240px] lg:justify-center lg:gap-10">
    <div class="entry-content prose dark:prose-invert min-w-0 max-w-none">
      <slot />
    </div>
    {toc.length > 0 && <TableOfContents items={toc} variant="desktop" />}
  </div>

  <div class="mx-auto mt-12 flex max-w-3xl flex-wrap items-center justify-between gap-4 border-t border-line pt-8">
    <ShareButton title={title} />
  </div>
</article>

<script>
  const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>`;
  const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>`;

  document.querySelectorAll<HTMLPreElement>(".entry-content pre").forEach((block) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy-button";
    button.innerHTML = copyIcon;
    button.setAttribute("aria-label", "コードをコピー");

    const popup = document.createElement("div");
    popup.className = "code-copy-popup";
    popup.textContent = "コピーしました";

    button.addEventListener("click", () => {
      const text = block.querySelector("code")?.textContent ?? "";
      navigator.clipboard.writeText(text);

      button.innerHTML = checkIcon;
      popup.classList.add("is-visible");

      setTimeout(() => {
        popup.classList.remove("is-visible");
        button.innerHTML = copyIcon;
      }, 1500);
    });

    // pre自身をposition:relativeにしているため、絶対配置の基準にするには
    // pre自身の子要素として追加する必要がある(afterendで兄弟にすると、
    // preのrelativeが効かず祖先を辿ってページ全体を基準に配置されてしまう)。
    block.appendChild(button);
    block.appendChild(popup);
  });

  // 本文中の画像(リンク内画像を除く)をクリックすると拡大表示する
  const images = Array.from(document.querySelectorAll<HTMLImageElement>(".entry-content img")).filter(
    (image) => !image.closest("a")
  );

  const openImageZoom = (image: HTMLImageElement) => {
    const dialog = document.createElement("dialog");
    dialog.className = "image-zoom-dialog";
    dialog.open = true;

    const copy = image.cloneNode() as HTMLImageElement;
    dialog.appendChild(copy);

    const close = () => {
      dialog.remove();
      document.removeEventListener("keydown", onKeydown);
    };
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape") close();
    };

    dialog.addEventListener("click", close);
    document.addEventListener("keydown", onKeydown);
    document.body.appendChild(dialog);
  };

  images.forEach((image) => {
    image.addEventListener("click", () => openImageZoom(image));
  });
</script>
