---
// src/components/BlogPost.astro
import {
  microCMSRichEditorHandler,
  responsiveImageTransformer,
  codeBlockFileNameTransformer,
  tocExtractor,
} from "microcms-rich-editor-handler";
import Date from "@components/Date.astro";
import { linkPreviewTransformer } from "@libs/linkPreview";
import type { Category } from "@libs/microcms";
import ShareButton from "@components/ShareButton.astro";

const { blog } = Astro.props;

let html = "";
let toc: TocItem[] = [];

if (blog.content) {
  const { html: transformedHtml, data } = await microCMSRichEditorHandler(
    blog.content,
    {
      transformers: [
        responsiveImageTransformer(),
        codeBlockFileNameTransformer({
          attributes: {
            class: "fileName",
          },
        }),
        linkPreviewTransformer(),
      ],
      extractors: {
        toc: [
          tocExtractor({
            ignoreLevels: [4, 5],
          }),
        ],
      },
    }
  );

  html = transformedHtml;
  toc = data.toc;
}

blog.content = html;
---

<article class="prose dark:prose-invert max-w-none">
  {
    blog.thumbnail?.url && (
      <img
        src={`${blog.thumbnail.url}?q=70&w=1200`}
        alt={blog.title}
        class="w-full aspect-video object-cover mb-8 not-prose"
      />
    )
  }

  <h1 class="text-3xl font-medium mb-3 leading-normal text-ink">{blog.title}</h1>

  <p class="mb-4">
    <Date date={blog.publishedAt || blog.createdAt} />
  </p>

  <div class="flex flex-wrap gap-2 mb-8">
    {
      blog.category?.length > 0 ? (
        blog.category.map((cat: Category) => (
          <a href={`/category/${cat.id}`} class="tag">
            {cat.name}
          </a>
        ))
      ) : (
        <span class="text-muted text-xs">No Category</span>
      )
    }
  </div>

  {toc.length > 0 && <TableOfContents items={toc} variant="mobile" />}

            return (
              <li
                class={`pl-4 list-none border-l-2 border-line ${levelClass}`}
              >
                <a
                  href={`#${item.id}`}
                  class="block font-normal no-underline hover:text-accent transition"
                >
                  {item.text}
                </a>
              </li>
            );
          })}
        </ul>
      </aside>
    )
  }

  <div set:html={blog.content} class="entry-content prose max-w-none" />

  <div class="not-prose mt-8 border-t border-line pt-8">
    <ShareButton title={blog.title} />
  </div>
</article>

<script>
  const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>`;
  const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>`;

  document.querySelectorAll<HTMLPreElement>(".entry-content pre").forEach((block) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy-button";
    button.innerHTML = copyIcon;
    button.setAttribute("aria-label", "コードをコピー");

    const popup = document.createElement("div");
    popup.className = "code-copy-popup";
    popup.textContent = "コピーしました";

    button.addEventListener("click", () => {
      const text = block.querySelector("code")?.textContent ?? "";
      navigator.clipboard.writeText(text);

      button.innerHTML = checkIcon;
      popup.classList.add("is-visible");

      setTimeout(() => {
        popup.classList.remove("is-visible");
        button.innerHTML = copyIcon;
      }, 1500);
    });

    // pre自身をposition:relativeにしているため、絶対配置の基準にするには
    // pre自身の子要素として追加する必要がある(afterendで兄弟にすると、
    // preのrelativeが効かず祖先を辿ってページ全体を基準に配置されてしまう)。
    block.appendChild(button);
    block.appendChild(popup);
  });

  // 本文中の画像(リンク内画像を除く)をクリックすると拡大表示する
  const images = Array.from(document.querySelectorAll<HTMLImageElement>(".entry-content img")).filter(
    (image) => !image.closest("a")
  );

  const openImageZoom = (image: HTMLImageElement) => {
    const dialog = document.createElement("dialog");
    dialog.className = "image-zoom-dialog";
    dialog.open = true;

    const copy = image.cloneNode() as HTMLImageElement;
    dialog.appendChild(copy);

    const close = () => {
      dialog.remove();
      document.removeEventListener("keydown", onKeydown);
    };
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape") close();
    };

    dialog.addEventListener("click", close);
    document.addEventListener("keydown", onKeydown);
    document.body.appendChild(dialog);
  };

  images.forEach((image) => {
    image.addEventListener("click", () => openImageZoom(image));
  });
</script>
