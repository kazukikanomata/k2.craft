---
// src/components/Header.astro
import ThemeToggle from "@components/ThemeToggle.astro";

interface Props {
  title: string;
}

const { title }: Props = Astro.props;
---

<header class="border-b">
  <div
    class="max-w-[1600px] w-full mx-auto px-4 md:px-6 xl:px-10 py-4 flex items-center justify-between"
  >
    <a href="/" class="flex items-center gap-2 no-underline">
      <span class="w-2.5 h-2.5 bg-accent" aria-hidden="true"></span>
      <span class="text-lg font-semibold text-ink">{title}</span>
    </a>
    <ThemeToggle />
  </div>
</header>
