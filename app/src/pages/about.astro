---
import Layout from "@layouts/Layout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
export const prerender = true;

const Meta = {
  title: "About",
  ogType: "article",
};
---

<Layout Meta={Meta}>
  <Breadcrumbs slot="breadcrumbs" items={[{ label: "About" }]} />
  <article class="prose max-w-none">
    <h1 class="text-3xl font-medium mb-3 leading-normal">About</h1>
  </article>
</Layout>
