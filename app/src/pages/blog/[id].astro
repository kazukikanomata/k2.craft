---
import { render } from "astro:content";
import { getPosts, getRelatedPosts } from "@libs/blog.ts";
import Layout from "@layouts/Layout.astro";
import BlogPost from "@components/BlogPost.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import RelatedArticles from "@components/RelatedArticles.astro";
import { CATEGORIES } from "@constants/index.ts";
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const toc = headings
  .filter(({ depth }) => depth <= 3)
  .map(({ slug, text, depth }) => ({ id: slug, text, level: depth }));

const relatedPosts = await getRelatedPosts(post);

const { title, description, category } = post.data;
const [firstCategory] = category;

const Meta = {
  title,
  image: new URL("/assets/images/og.png", Astro.site),
  ogType: "article",
  description,
};
---

<Layout Meta={Meta}>
  <Breadcrumbs
    slot="breadcrumbs"
    items={
      firstCategory
        ? [{ label: firstCategory, href: `/category/${CATEGORIES[firstCategory]}` }, { label: title }]
        : [{ label: title }]
    }
  />
  <div class="space-y-8">
    <BlogPost post={post} toc={toc}>
      <Content />
    </BlogPost>
    <RelatedArticles posts={relatedPosts} />
  </div>

  <div>
    {toc.length > 0 && <TableOfContents items={toc} variant="desktop" />}
  </div>
</Layout>
