---
import { getPosts, paginate, totalPages } from "@libs/blog.ts";
import Layout from "@layouts/Layout.astro";
import BlogList from "@components/BlogList.astro";
import Pagination from "@components/Pagination.astro";
import CategoryList from "@components/CategoryList.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPosts();

  return Array.from({ length: totalPages(posts.length) }).map((_, i) => ({
    params: { page: (i + 1).toString() },
    props: { posts: paginate(posts, i + 1), totalCount: posts.length },
  }));
}

const { page } = Astro.params;
const { posts, totalCount } = Astro.props;
const currentPage = Number(page);

const Meta = {
  title: `Page ${currentPage}`,
};
---

<Layout Meta={Meta}>
  <Breadcrumbs slot="breadcrumbs" items={[{ label: `Page ${currentPage}` }]} />
  <div class="space-y-8">
    <BlogList posts={posts} />
    <Pagination totalCount={totalCount} current={currentPage} />
  </div>

  <div class="space-y-8">
    <CategoryList />
  </div>
</Layout>
